{
  "source": { "file": "package.json", "key": "version" },
  "files": [
    { "file": "package-lock.json", "regex": "^  \"version\": \"{v}\",$" },
    { "file": "package-lock.json", "regex": "^    \"\": \\{\\n      \"name\": \"[^\"]+\",\\n      \"version\": \"{v}\",$" },
    { "file": "docs/index.html", "pattern": "version: '{v}' }\">" },
    { "file": "docs/404.html", "pattern": "version: '{v}' }\">" },
    { "file": "dist/iife/nojs-elements.js", "pattern": " * NoJS Elements v{v} — ", "generated": true },
    { "file": "dist/esm/nojs-elements.js", "pattern": " * NoJS Elements v{v} — ", "generated": true },
    { "file": "dist/cjs/nojs-elements.js", "pattern": " * NoJS Elements v{v} — ", "generated": true }
  ],
  "build": "npm run build",
  "hooks": { "dir": ".githooks" },
  "reviewAllowlist": [],
  "scanExclude": [
    "CHANGELOG.md",
    "node_modules/",
    ".github/reviews/",
    "*.pen",
    "package-lock.json"
  ]
}
